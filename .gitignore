# =============================================================================
# Project-root .gitignore for the AI Video Generation SaaS
#
# This file applies to the entire repository.  Subdirectories may have their
# own narrower .gitignore (e.g. backend/.gitignore) which inherits from this.
#
# Convention: if a generated/cache/secret artefact CAN appear anywhere in the
# tree, list it here.  Component-specific ignores belong in the component's
# own .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets — never commit
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.validation
.env.production
.env.staging
*.pem
*.key
*.p12
*.pfx
secrets/
.secrets/

# Keep example envs — they document required variables without exposing values.
!.env.example
!**/.env.example

# -----------------------------------------------------------------------------
# Python — runtime artefacts and bytecode
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Build / packaging
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
*.egg-info/
*.egg
parts/
sdist/
wheels/
share/python-wheels/
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
.venv*/
venv/
env/
ENV/
env.bak/
venv.bak/

# -----------------------------------------------------------------------------
# Test, lint, type-check, and coverage caches
# -----------------------------------------------------------------------------
.pytest_cache/
.cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.import_linter_cache/
.tox/
.nox/
.hypothesis/

# Coverage
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover
htmlcov/
.junit/

# -----------------------------------------------------------------------------
# Local validation / inspection outputs (Phase 2 tooling)
# -----------------------------------------------------------------------------
.validation/
*.validation.log

# -----------------------------------------------------------------------------
# Alembic — never commit auto-generated SQL dumps or stamp files
# -----------------------------------------------------------------------------
*.sql.dump
alembic.local.ini

# -----------------------------------------------------------------------------
# Editor / IDE
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.netrwhist
*.iml

# Cursor — keep workspace rules under .cursor/rules/, ignore session/state files
.cursor/state/
.cursor/cache/

# -----------------------------------------------------------------------------
# Operating system noise
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# Logs and temporary files
# -----------------------------------------------------------------------------
*.log
logs/
*.tmp
*.bak
*.backup
*.orig
nohup.out

# -----------------------------------------------------------------------------
# Node / frontend (placeholder — frontend will be added in Phase 4)
# -----------------------------------------------------------------------------
node_modules/
.next/
.nuxt/
.cache/
out/
.parcel-cache/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# Docker — keep compose files and Dockerfiles, ignore local overrides
# -----------------------------------------------------------------------------
docker-compose.override.yml
docker-compose.*.local.yml

# -----------------------------------------------------------------------------
# Large/binary artefacts that should never live in git
# -----------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.iso
*.dmg
*.exe
