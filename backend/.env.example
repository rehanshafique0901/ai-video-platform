# Backend runtime environment variables.
#
# Copy this file to .env.validation and fill in the real values. Both
# the scripts (validate_schema, regenerate_erd, ci_gate via _load_env)
# and the runtime application (app/core/config.Settings via
# pydantic-settings) read from .env.validation. The file is gitignored.

# --- Database (Phase 2 baseline) -----------------------------------------
# psycopg3 async driver, SQLAlchemy URL form.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname?sslmode=require

# --- JWT (ADR-0008, Phase 3 Slice α1 onwards) ----------------------------
# HS256 signing key. MUST be at least 32 characters of high-entropy random
# data. Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-at-least-32-random-characters-from-the-secrets-module
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- Observability + environment ----------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=local

# --- Providers · OpenAI Images (Phase 3 Slice α8.1) ----------------------
# Optional. When OPENAI_API_KEY is unset the IMAGE capability stays on the
# deterministic MockImageProvider; when set, the process wires the real
# synchronous OpenAIImageProvider for IMAGE (LLM/VIDEO/VOICE remain mock).
# The key is injected into the provider's shared httpx client at startup —
# the provider itself is configuration-blind (W8.1.1).
# OPENAI_API_KEY=sk-replace-with-a-real-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=60.0
